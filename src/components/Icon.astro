---
type Name =
  | 'arrow' | 'arrow-left' | 'arrow-up-right' | 'down' | 'download' | 'plus' | 'minus' | 'close' | 'chev'
  | 'play' | 'mail' | 'phone' | 'pin' | 'whatsapp' | 'linkedin' | 'youtube' | 'instagram'
  | 'facebook' | 'x' | 'search' | 'doc' | 'link' | 'images' | 'globe' | 'megaphone';
interface Props { name: Name; class?: string; label?: string }
const { name, class: cls, label } = Astro.props;
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6, 'stroke-linecap': 'square' as const, 'stroke-linejoin': 'miter' as const };
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
{name === 'megaphone' && <svg viewBox="0 0 24 24" class={cls} {...stroke} stroke-linecap="round" stroke-linejoin="round" {...a11y}><path d="M4 9.5h3.5L15 5v14l-7.5-4.5H4zM7.5 14.5l1.4 4.5h2.6l-1.2-3.8M18.5 9.5a3.5 3.5 0 0 1 0 5" /></svg>}
{name === 'globe' && <svg viewBox="0 0 24 24" class={cls} {...stroke} stroke-linecap="round" {...a11y}><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>}
{name === 'arrow' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M3 12h17M14 6l6 6-6 6" /></svg>}
{name === 'arrow-left' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M21 12H4M10 6l-6 6 6 6" /></svg>}
{name === 'arrow-up-right' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M7 17L17 7M8 7h9v9" /></svg>}
{name === 'down' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M12 4v15M6 13l6 6 6-6" /></svg>}
{name === 'download' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>}
{name === 'plus' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M12 4v16M4 12h16" /></svg>}
{name === 'minus' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M4 12h16" /></svg>}
{name === 'close' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M5 5l14 14M19 5L5 19" /></svg>}
{name === 'chev' && <svg viewBox="0 0 24 24" class={cls} {...stroke} stroke-width="2.4" {...a11y}><path d="M5 9l7 7 7-7" /></svg>}
{name === 'play' && <svg viewBox="0 0 24 24" class={cls} fill="currentColor" {...a11y}><path d="M7 4.5v15l12-7.5z" /></svg>}
{name === 'mail' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M3 5h18v14H3zM3 6l9 7 9-7" /></svg>}
{name === 'phone' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M5 3h4l2 5-2.5 1.5a11 11 0 005 5L15 12l5 2v4a2 2 0 01-2 2A16 16 0 013 5a2 2 0 012-2z" /></svg>}
{name === 'pin' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>}
{name === 'search' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><circle cx="11" cy="11" r="6.5" /><path d="M16 16l5 5" /></svg>}
{name === 'doc' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6" /></svg>}
{name === 'link' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6" /></svg>}
{name === 'images' && <svg viewBox="0 0 24 24" class={cls} {...stroke} {...a11y}><path d="M3 6h14v12H3zM7 3h14v12M3 15l4-4 4 4 3-3 3 3" /></svg>}
{name === 'whatsapp' && <svg viewBox="0 0 24 24" class={cls} fill="currentColor" {...a11y}><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 01-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.3 3 3 0 00-.9 2.2 5.2 5.2 0 001.1 2.7 11.8 11.8 0 004.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 001.8-1.3 2.2 2.2 0 00.2-1.3c-.1-.1-.3-.2-.6-.3z"/></svg>}
{name === 'linkedin' && <svg viewBox="0 0 24 24" class={cls} fill="currentColor" {...a11y}><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.1a4.2 4.2 0 013.8-2c4 0 4.8 2.7 4.8 6.1V21h-4v-5.5c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21H9z"/></svg>}
{name === 'youtube' && <svg viewBox="0 0 24 24" class={cls} fill="currentColor" {...a11y}><path d="M23 7.2a3 3 0 00-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 001 7.2 31 31 0 00.6 12a31 31 0 00.4 4.8 3 3 0 002.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 002.1-2.1 31 31 0 00.4-4.8 31 31 0 00-.4-4.8zM9.7 15.1V8.9l5.8 3.1z"/></svg>}
{name === 'instagram' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.7" {...a11y}><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>}
{name === 'facebook' && <svg viewBox="0 0 24 24" class={cls} fill="currentColor" {...a11y}><path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.3A21 21 0 0014.6 2C12.1 2 10.5 3.5 10.5 6.3v2.2H8v3.4h2.5V22H14V11.9h2.7l.4-3.4z"/></svg>}
{name === 'x' && <svg viewBox="0 0 24 24" class={cls} fill="currentColor" {...a11y}><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.9 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"/></svg>}
