---
import Base from '../layouts/Base.astro';
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';
import { articlesBy, articleUrl, categoryLabel, categoryMeta, formatDate, hasEnglish, localize, type Article } from '../lib/content';
import { langOf } from '../i18n';
import { company } from '../data/site';

interface Props { article: Article }
const lang = langOf(Astro.params);
const a = localize(Astro.props.article, lang);
// an English page whose article only exists in Indonesian says so, and marks the text as Indonesian
const idOnly = lang === 'en' && !hasEnglish(a);
const textLang = idOnly ? 'id' : undefined;
const L = {
  id: { info: 'Info artikel', category: 'Kategori', date: 'Tanggal', by: 'Oleh', share: 'Bagikan', shareTo: 'Bagikan ke', copy: 'Salin Tautan', other: 'Artikel lain', prev: '← Sebelumnya', next: 'Berikutnya →', more: 'lainnya', seeAll: 'Lihat semua', idOnly: '' },
  en: { info: 'Article info', category: 'Category', date: 'Date', by: 'By', share: 'Share', shareTo: 'Share on', copy: 'Copy Link', other: 'Other articles', prev: '← Previous', next: 'Next →', more: '', seeAll: 'See all', idOnly: 'This article is only available in Indonesian.' },
}[lang];
const list = articlesBy(a.category, lang);
const idx = list.findIndex((x) => x.slug === a.slug);
const newer = idx > 0 ? list[idx - 1] : undefined;
const older = idx < list.length - 1 ? list[idx + 1] : undefined;
const related = list.filter((x) => x.slug !== a.slug).slice(Math.max(0, idx - 1), Math.max(0, idx - 1) + 3);
const meta = { ...categoryMeta[a.category], label: categoryLabel(a.category, lang) };
const parent = { label: meta.label, href: meta.list };
const site = Astro.site ?? new URL('https://www.pgn-solution.co.id');
const url = new URL(Astro.url.pathname, site).href;
const enc = encodeURIComponent(url);
const encT = encodeURIComponent(a.title);
const share = [
  { label: 'LinkedIn', icon: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc}` },
  { label: 'X', icon: 'x', href: `https://twitter.com/intent/tweet?url=${enc}&text=${encT}` },
  { label: 'WhatsApp', icon: 'whatsapp', href: `https://wa.me/?text=${encT}%20${enc}` },
  { label: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${enc}` },
] as const;
const ld = {
  '@context': 'https://schema.org',
  '@type': a.category === 'press-release' ? 'NewsArticle' : 'Article',
  headline: a.title,
  datePublished: a.isoDate,
  image: a.image ? [new URL(a.image, site).href] : undefined,
  author: a.author ? { '@type': 'Person', name: a.author } : undefined,
  publisher: { '@type': 'Organization', name: company.name, logo: { '@type': 'ImageObject', url: new URL('/media/brand/home-logo.png', site).href } },
  description: a.excerpt,
};
---
<Base title={a.title} description={a.excerpt} image={a.image ?? undefined} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <article>
    <header class="phero gridbg ad-head">
      <div class="wrap phero__inner">
        <p class="t-mono hero-fade"><span style="color:var(--blue-ink)">{meta.label}</span>&nbsp;&nbsp;·&nbsp;&nbsp;<time datetime={a.isoDate}>{formatDate(a.isoDate, lang)}</time></p>
        <h1 class="t-caps ad-title hero-fade" lang={textLang}>{a.title}</h1>
        {idOnly && <p class="ad-note hero-fade">{L.idOnly}</p>}
      </div>
    </header>
    {a.image && (
      <div class="pband hero-fade" data-notch-band>
        <img src={a.image} alt="" fetchpriority="high" decoding="async" data-parallax="0.06" />
      </div>
    )}

    <div class="section ad-body">
      <div class="wrap">
        <div class="ad-grid">
          <aside class="ad-rail" aria-label={L.info}>
            <div class="card ad-meta">
              <dl>
                <div><dt class="t-mono">{L.category}</dt><dd><a class="text-link" href={parent.href}>{meta.label}</a></dd></div>
                <div><dt class="t-mono">{L.date}</dt><dd>{formatDate(a.isoDate, lang)}</dd></div>
                {a.author && <div><dt class="t-mono">{L.by}</dt><dd>{a.author}</dd></div>}
              </dl>
              <div class="ad-share">
                <p class="t-mono">{L.share}</p>
                <ul role="list">{share.map((s) => <li><a class="icon-btn" href={s.href} target="_blank" rel="noopener" aria-label={`${L.shareTo} ${s.label}`} style="width:44px;height:44px;background:#fff"><Icon name={s.icon} /></a></li>)}</ul>
                <button type="button" class="btn btn--soft btn--block" data-copy={url}>{L.copy}</button>
              </div>
            </div>
          </aside>
          <div class="prose ad-prose" lang={textLang} set:html={a.body} />
        </div>
      </div>
    </div>
  </article>

  <nav class="wrap" aria-label={L.other}>
    <div class="cards" style="--n:2">
      {older ? (
        <a class="card ad-nav" href={articleUrl(older)} rel="prev">
          <p class="t-mono">{L.prev}</p>
          <p class="t-caps" style="font-size:clamp(17px,1.4vw,21px)">{older.title}</p>
        </a>
      ) : <span></span>}
      {newer && (
        <a class="card ad-nav ad-nav--next" href={articleUrl(newer)} rel="next">
          <p class="t-mono">{L.next}</p>
          <p class="t-caps" style="font-size:clamp(17px,1.4vw,21px)">{newer.title}</p>
        </a>
      )}
    </div>
  </nav>

  {related.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <div class="wrap">
        <div class="head-row">
          <h2 id="related-title" class="t-lg">{lang === 'en' ? ({ 'press-release': 'More press releases', news: 'More news', csr: 'More CSR stories' } as const)[a.category] : `${meta.label} ${L.more}`}</h2>
          {a.category !== 'csr' && <a class="link" href={meta.list}>{L.seeAll}<Icon name="arrow" /></a>}
        </div>
        <div class="cards" style="--n:3">{related.map((r) => <ArticleCard article={r} showCategory={false} ratio="3/2" />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .ad-head { padding-bottom: clamp(40px, 4vw, 64px); }
  .ad-note { margin: 0; font-size: 14px; color: var(--fg-muted); }
  /* titles are all-caps in the source copy, so they run long: smaller and wider, balanced lines */
  .ad-title { font-family: var(--display); font-weight: 500; font-size: clamp(24px, 2.3vw, 38px); line-height: 1.15; letter-spacing: 0; max-width: 40ch; text-wrap: balance; }
  .ad-body { padding-top: clamp(48px, 5vw, 88px); }
  .ad-grid { display: grid; grid-template-columns: minmax(0, 3.2fr) minmax(0, 8fr); gap: clamp(32px, 5vw, 96px); align-items: start; }
  .ad-rail { position: sticky; top: calc(var(--header-top) + var(--header-h) + 32px); }
  .ad-meta { gap: 28px; }
  .ad-meta dl { margin: 0; display: grid; gap: 18px; }
  .ad-meta dd { margin: 8px 0 0; font-size: 17px; }
  .ad-share { display: grid; gap: 14px; }
  .ad-share ul { display: flex; gap: 8px; padding: 0; margin: 0; list-style: none; }
  .ad-share :global(svg) { width: 16px; height: 16px; }
  @media (max-width: 1000px) { .ad-grid { grid-template-columns: 1fr; } .ad-rail { position: static; order: 2; } }
  .ad-nav { gap: 18px; transition: background-color 0.3s; }
  .ad-nav:hover { background: #e6e6e6; }
  .ad-nav--next { text-align: right; align-items: flex-end; grid-column: 2; }
  @media (max-width: 680px) { .ad-nav--next { grid-column: auto; } }
</style>
