---
import Base from '../layouts/Base.astro';
---
<Base title="Halaman tidak ditemukan">
  <section class="phero gridbg" style="min-height:80svh">
    <div class="wrap phero__inner">
      <p class="t-mono">404</p>
      <h1 class="t-xl" style="max-width:16ch">Halaman yang Anda cari tidak ditemukan</h1>
      <p class="t-body">Alamat mungkin sudah berubah karena struktur website yang baru. Gunakan menu atau mulai dari beranda.</p>
      <div class="phero__actions">
        <a class="btn btn--primary btn--lg" href="/">Ke Beranda</a>
        <a class="btn btn--soft btn--lg" href="/articles">Lihat Artikel</a>
      </div>
      <!-- one 404 page serves both languages -->
      <p class="t-body" lang="en" style="margin-top:8px">The page you are looking for cannot be found. <a class="text-link" href="/en">Go to the English home page</a>.</p>
    </div>
  </section>
</Base>
