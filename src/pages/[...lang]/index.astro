---
import { langOf, langPaths } from '../../i18n';
import { content } from '../../i18n/content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Frame from '../../components/Frame.astro';
import Notch from '../../components/Notch.astro';
import SectionHead from '../../components/SectionHead.astro';
import LogoCarousel from '../../components/LogoCarousel.astro';
import { articlesBy, articlesIn, articleUrl, categoryLabel, clients, formatDate, hasEnglish } from '../../lib/content';

const lang = langOf(Astro.params);
const { companyStats, homeBusiness, lines, clientsBlock, aboutHero } = content(lang);
const articles = articlesIn(lang);
// page words; the English hero follows the original English homepage
const L = {
  id: {
    heroLines: ['Solusi Total Untuk', 'Energi dan Infrastruktur'],
    heroText: 'PT PGAS Solution adalah anak perusahaan dari PT Perusahaan Gas Negara Tbk. yang menyediakan berbagai layanan di bidang Energi dan Infrastruktur',
    heroAlt: 'Anjungan lepas pantai berwarna kuning di tengah laut dengan kapal pendukung di kejauhan',
    latest: 'Artikel terbaru', seeAll: 'Lihat semua', more: 'Selengkapnya', about: 'tentang', aboutEyebrow: 'Tentang Kami', aboutCta: 'Kenali Kami Lebih Jauh',
    clients: 'Klien kami', info: 'Informasi', feedTitle: 'Press Release & Berita', prev: 'Artikel sebelumnya', next: 'Artikel berikutnya', read: 'Baca', since: 'sejak',
    alts: { epc: 'Kapal crane memasang modul anjungan lepas pantai dengan pipa kuning di latar depan', om: 'Fasilitas pipa gas kuning dan tangki berlogo PGN Solution', 'supply-chain': 'Pipa baja diangkut forklift dan crane di pelabuhan', tuk: 'Peralatan pelatihan katup dan alat ukur tekanan di ruang praktik' } as Record<string, string>,
  },
  en: {
    heroLines: ['Total Solution for', 'Energy and Infrastructure'],
    heroText: 'PT PGAS Solution is a leading government-owned enterprise that provides a full range of services in Energy and Infrastructure',
    heroAlt: 'Yellow offshore platform at sea with a support vessel in the distance',
    latest: 'Latest article', seeAll: 'See all', more: 'Learn more', about: 'about', aboutEyebrow: 'About Us', aboutCta: 'Get to Know Us',
    clients: 'Our clients', info: 'Information', feedTitle: 'Press Release & News', prev: 'Previous article', next: 'Next article', read: 'Read', since: 'since',
    alts: { epc: 'Crane vessel installing an offshore platform module with yellow pipes in the foreground', om: 'Yellow gas pipeline facility and a tank with the PGN Solution logo', 'supply-chain': 'Steel pipes moved by forklift and crane at a port', tuk: 'Valve training equipment and pressure gauges in a practice room' } as Record<string, string>,
  },
}[lang];
const hero = { lines: L.heroLines, text: L.heroText };
// Newest article (any category) for the hero glass card; prefer one with a photo.
const latest = articles.find((a) => a.image) ?? articles[0];
// Card photos for the four business lines (supplied by PGN Solution, public/media/bussines).
const bizImages: Record<string, { src: string; alt: string }> = {
  epc: { src: '/media/bussines/epc.jpg', alt: L.alts.epc },
  om: { src: '/media/bussines/om.jpg', alt: L.alts.om },
  'supply-chain': { src: '/media/bussines/supply-chain.jpg', alt: L.alts['supply-chain'] },
  tuk: { src: '/media/bussines/tuk.jpg', alt: L.alts.tuk },
};
const steps = [
  { idx: '01', head: `${L.since} ${companyStats[0].value}`, body: companyStats[0].label, image: '/media/about/step-1.jpg' },
  { idx: '02', head: `${companyStats[1].value} ${companyStats[1].suffix}`, body: companyStats[1].label, image: '/media/about/step-2.jpg' },
  { idx: '03', head: `>${companyStats[2].value} ${companyStats[2].suffix}`, body: companyStats[2].label, image: '/media/about/step-3.jpg' },
];
// Latest press releases and news together (5 + 3, so news still shows up — it is published far less
// often), newest first.
const feed = [...articlesBy('press-release', lang).slice(0, 5), ...articlesBy('news', lang).slice(0, 3)].sort((a, b) => (a.isoDate < b.isoDate ? 1 : -1));
export const getStaticPaths = langPaths;
---
<Base description={hero.text} image="/media/hero/home.jpg">
  <!-- HERO -->
  <section class="hero theme-dark" style="background:#050607" aria-labelledby="hero-title" data-sheet-under>
    <div class="hero__bg">
    <div class="hero__media">
      <!-- static photo (supplied as public/media/hero/image 12.png; was a YouTube background video) -->
      <img class="hero-settle" src="/media/hero/home.webp" srcset="/media/hero/home.webp 1510w, /media/hero/home@2x.webp 3020w" sizes="100vw" alt={L.heroAlt} fetchpriority="high" decoding="async" />
    </div>
    </div>
    <div class="hero__content">
      <div class="hero__copy">
        <h1 id="hero-title" class="t-hero hero__title" aria-label={hero.lines.join(' ')}>
          {hero.lines.map((l) => <span class="line-mask" aria-hidden="true"><span>{l}</span></span>)}
        </h1>
        <p class="t-body hero__text hero-fade">{hero.text}</p>
      </div>
      {latest && (
        <aside class="hero__news hero-fade" aria-labelledby="hero-news-label" data-notch-card>
          <svg class="hero__news-edge" aria-hidden="true" focusable="false"><path /></svg>
          <div class="hero__news-head">
            <p id="hero-news-label" class="hero__news-label">{L.latest}</p>
            <a class="hero__news-all" href="/articles">{L.seeAll}<Icon name="arrow-up-right" /></a>
          </div>
          <a class="hero__news-item" href={articleUrl(latest)}>
            {latest.image && <span class="hero__news-thumb"><img src={latest.image} alt="" decoding="async" /></span>}
            <span class="hero__news-body">
              <span class="hero__news-meta">
                <span class="hero__news-cat">{categoryLabel(latest.category, lang)}</span>
                <time datetime={latest.isoDate}>{formatDate(latest.isoDate, lang)}</time>
              </span>
              <span class="hero__news-title" lang={lang === 'en' && !hasEnglish(latest) ? 'id' : undefined}>{latest.title}</span>
            </span>
          </a>
        </aside>
      )}
    </div>
  </section>

  <!-- White sheet that slides up over the pinned hero. Its top edge has a tab-shaped
       cut-out (the reference "notch") whose depth follows scroll: deep while the sheet
       is low in the viewport, flat by the time it reaches the top. -->
  <div class="sheet" data-sheet>
  <div class="sheet__edge" aria-hidden="true">
    <span class="sheet__fill"></span>
    <svg viewBox="0 0 56 36" preserveAspectRatio="none"><path d="M0 0H7C12 0 15 1.8 17.6 5L39.4 31C42 34.2 45 36 50 36H0Z" /></svg>
    <span class="sheet__hole"></span>
    <svg viewBox="0 0 56 36" preserveAspectRatio="none" style="transform:scaleX(-1)"><path d="M0 0H7C12 0 15 1.8 17.6 5L39.4 31C42 34.2 45 36 50 36H0Z" /></svg>
    <span class="sheet__fill"></span>
  </div>

  <!-- BUSINESS -->
  <section class="section sheet__first biz-sec" aria-labelledby="biz-title">
    <div class="wrap">
      <div class="biz-head">
        <SectionHead eyebrow={homeBusiness.eyebrow} title={homeBusiness.title} text={homeBusiness.text} id="biz-title" maxw="24ch" />
      </div>
      <ul class="biz" role="list">
        {lines.map((l, i) => (
          <li class="biz__card" data-reveal="fade" style={`transition-delay:${i * 70}ms`}>
            <div class="biz__media">
              <img src={bizImages[l.id]?.src ?? l.image} alt={bizImages[l.id]?.alt ?? l.imageAlt} loading="lazy" decoding="async" />
              <span class="biz__tag">{l.tag === 'SC' ? 'Supply Chain' : l.tag}</span>
            </div>
            <div class="biz__body">
              <h3 class="biz__title">{l.title}</h3>
              <p class="biz__text">{l.text}</p>
            </div>
            <a class="biz__link" href={`/business#${l.id}`}>{L.more}<span class="visually-hidden"> {L.about} {l.title}</span><Icon name="arrow" /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ABOUT / FEATURE STEPS -->
  <section class="section steps-sec about-sec" aria-labelledby="about-title">
    <!-- side decoration (one asset, mirrored on the right), after thelaunchcompany.cc's gantries -->
    <div class="pipe pipe--l" aria-hidden="true"><img src="/media/client/pipe-xl.webp" alt="" width="600" height="5359" loading="lazy" decoding="async" /></div>
    <div class="pipe pipe--r" aria-hidden="true"><img src="/media/client/pipe-xl.webp" alt="" width="600" height="5359" loading="lazy" decoding="async" /></div>
    <div class="wrap">
      <SectionHead eyebrow={L.aboutEyebrow} title={aboutHero.title} text={aboutHero.text} id="about-title" maxw="14ch">
        <a class="btn btn--primary btn--lg" href="/about">{L.aboutCta}</a>
      </SectionHead>
      <div class="steps" data-steps>
        <ol class="steps__list" role="list">
          {steps.map((s, i) => (
            <li class:list={['steps__item', i === 0 && 'is-active']} data-step>
              <span class="t-index steps__idx">{s.idx}</span>
              <p class="t-num steps__head" data-split>{s.head}</p>
              <p class="steps__body" data-split>{s.body}</p>
            </li>
          ))}
        </ol>
        <div class="steps__stage">
          <div class="steps__sticky media media--lg">
            {steps.map((s, i) => <img class:list={['steps__img', i === 0 && 'is-active']} src={s.image} alt="" loading="lazy" decoding="async" data-step-img />)}
            <Notch dir="right" color="#fff" depth={30} class="steps__notch" style="left:0;top:8.7%;height:44%" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <section class="section clients-sec" aria-labelledby="clients-title">
    <div class="wrap">
      <SectionHead eyebrow={clientsBlock.eyebrow} title={clientsBlock.title} text={clientsBlock.text} id="clients-title" maxw="17ch" />
      <div class="clients-sec__strip"><LogoCarousel logos={clients} label={L.clients} /></div>
    </div>
  </section>

  <!-- LATEST -->
  <section class="section feed" aria-labelledby="feed-title" data-scroller>
    <div class="wrap feed__head">
      <div>
        <p class="t-eyebrow">{L.info}</p>
        <h2 id="feed-title" class="t-xl" style="margin-top:28px">{L.feedTitle}</h2>
      </div>
      <div class="feed__nav">
        <button type="button" class="chev-btn chev-btn--prev" data-scroller-prev aria-label={L.prev}><Icon name="chev" /></button>
        <button type="button" class="chev-btn chev-btn--next" data-scroller-next aria-label={L.next}><Icon name="chev" /></button>
      </div>
    </div>
    <ul class="feed__track" role="list" data-scroller-track>
      {feed.map((a) => (
        <li class="feed__card theme-dark">
          {a.image && <img class="feed__bg" src={a.image} alt="" loading="lazy" decoding="async" />}
          <span class="feed__badge">{categoryLabel(a.category, lang)}</span>
          <div class="feed__body">
            <h3 class="feed__title" title={a.title} lang={lang === 'en' && !hasEnglish(a) ? 'id' : undefined}>{a.title}</h3>
            <p class="feed__excerpt" lang={lang === 'en' && !hasEnglish(a) ? 'id' : undefined}>{a.excerpt}</p>
            <div class="feed__foot">
              <time class="feed__date" datetime={a.isoDate}>{formatDate(a.isoDate, lang)}</time>
              <a class="btn btn--secondary feed__btn" href={articleUrl(a)}>{L.read}<span class="visually-hidden"> {a.title}</span></a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
  </div>
</Base>

<style>
  /* HERO */
  /* pinned: the page's white sheet slides up over it (JS sets `top` so a hero taller than the viewport still shows its bottom) */
  .hero { position: sticky; top: 0; z-index: 0; min-height: 100svh; display: grid; align-content: end; color: #fff; }
  /* clip box for the parallax layer, so the photo always reaches the hero's bottom edge */
  /* extends below the hero so the slower-rising photo still fills the sheet's notch cut-out */
  .hero__bg { position: absolute; inset: 0 0 -64px 0; overflow: hidden; will-change: transform; }
  .hero__media { position: absolute; inset: -8% 0 -8% 0; overflow: hidden; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 30%; }
  /* copy bottom-left, latest-article glass card bottom-right */
  .hero__content {
    position: relative; z-index: 1; will-change: transform; width: 100%; max-width: calc(1680px + 2 * var(--pad-x-header)); margin-inline: auto;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: clamp(32px, 5vw, 96px);
    /* same side insets as the header; 30px off the bottom edge */
    padding: calc(var(--header-top) + var(--header-h) + 48px) var(--pad-x-header) 30px;
  }
  /* headline always sits on exactly two lines: its size follows the copy column's width */
  /* copy lines up with the logo inside the header (header's left padding) */
  .hero__copy { display: grid; gap: clamp(20px, 2vw, 32px); justify-items: start; container-type: inline-size; padding-left: 24px; }
  @media (max-width: 1280px) { .hero__copy { padding-left: 22px; } .hero__content { max-width: calc(940px + 2 * var(--pad-x-header)); } }
  @media (max-width: 600px) { .hero__copy { padding-left: 16px; } }
  .hero__title { color: #fff; font-size: clamp(28px, 4.4vw, 84px); }
  @supports (font-size: 1cqi) { .hero__title { font-size: min(84px, 9cqi); } }
  .hero__title :global(.line-mask > span) { white-space: nowrap; }
  /* two lines at most: wide enough to fit in two balanced lines on desktop, clamped on narrow screens */
  .hero__text {
    color: rgba(255, 255, 255, 0.78); max-width: 760px; text-wrap: balance;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  .hero__news {
    width: 400px; padding: 16px; border-radius: 16px;
    background: rgba(22, 27, 36, 0.55);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 10px 30px -12px rgba(0, 0, 0, 0.35);
  }
  /* once JS cuts the notch between "Artikel terbaru" and "Lihat semua", the edge is drawn by this SVG instead */
  .hero__news { position: relative; }
  .hero__news-edge { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; display: none; }
  .hero__news-edge path { fill: none; stroke: rgba(255, 255, 255, 0.16); stroke-width: 1; }
  .hero__news.is-notched { box-shadow: none; }
  .hero__news.is-notched .hero__news-edge { display: block; }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .hero__news { background: rgba(22, 27, 36, 0.9); } }
  .hero__news-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 2px 4px 14px; }
  .hero__news-label { margin: 0; font-size: 13px; color: rgba(255, 255, 255, 0.7); }
  .hero__news-all { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #fff; transition: color 0.25s; }
  .hero__news-all :global(svg) { width: 14px; height: 14px; }
  .hero__news-all:hover { color: var(--blue-lit); }
  .hero__news-item { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px; align-items: center; padding: 8px; margin: 0 -4px -4px; border-radius: 10px; transition: background-color 0.25s; }
  .hero__news-item:hover { background: rgba(255, 255, 255, 0.06); }
  .hero__news-thumb { display: block; aspect-ratio: 4 / 3; border-radius: 8px; overflow: hidden; background: rgba(255, 255, 255, 0.06); }
  .hero__news-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .hero__news-item:hover .hero__news-thumb img { transform: scale(1.06); }
  .hero__news-body { display: grid; gap: 8px; min-width: 0; }
  .hero__news-meta { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 12px; color: rgba(255, 255, 255, 0.6); }
  .hero__news-cat { color: var(--blue-lit); }
  .hero__news-title {
    font-family: var(--display); font-size: 15px; font-weight: 500; line-height: 1.3; color: #fff;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  @media (max-width: 1280px) {
    .hero__content { grid-template-columns: 1fr; align-items: start; }
    .hero__news { width: 100%; max-width: 480px; }
  }
  @media (max-width: 480px) {
    .hero__news-item { grid-template-columns: 88px minmax(0, 1fr); gap: 12px; }
  }
  .sheet { --cut-d: 40px; --biz-bg: #f5f6f7; position: relative; z-index: 1; }
  .sheet::before { content: ''; position: absolute; inset: calc(var(--cut-d) - 1px) 0 0 0; z-index: -1; background: var(--white); }
  /* edge colour = first section's background (Bisnis Kami grey) */
  .sheet__edge { position: absolute; top: 0; left: 0; right: 0; z-index: -1; height: var(--cut-d); display: flex; color: var(--biz-bg); pointer-events: none; }
  .sheet__fill { flex: 1; background: currentColor; }
  .sheet__edge svg { flex: none; width: 56px; height: 100%; margin-inline: -0.5px; fill: currentColor; }
  .sheet__hole { flex: none; width: calc(min(940px, 72vw) - 112px); }

  /* CLIENTS */
  /* clients: room above and below the logo row for its fading grid lines */
  /* the faded grid lines under the row already give the breathing room, so no extra bottom padding */
  .clients-sec { overflow-x: clip; padding-bottom: 0; }
  .clients-sec__strip { margin-top: calc(min(11.979vw, 200px) + 24px); margin-bottom: min(11.979vw, 200px); }
  @media (max-width: 1365px) { .clients-sec__strip { margin-bottom: max(0px, calc(min(11.979vw, 200px) - 60px)); } }

  /* about: yellow pipes either side (thelaunchcompany.cc gantry pattern). They have a fixed size and the
     section content narrows to stay 32px clear of their widest point (flanges = 84% of the artwork,
     12% of which sits off-screen → 72% visible). */
  .about-sec {
    position: relative; overflow-x: clip;
    --pipe-w: clamp(200px, 16.5vw, 340px);
    --pipe-vis: calc(var(--pipe-w) * 0.72);
  }
  /* all section content shares one layer under the pipes, so the pipes are always the front-most thing */
  .about-sec > .wrap { position: relative; z-index: 1; }
  .pipe {
    display: none; position: absolute; top: 0; bottom: 0; z-index: 2; width: var(--pipe-w); overflow: hidden; pointer-events: none;
    /* box = section height: fades out before the section ends so nothing spills into the next one */
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
  }
  /* the artwork itself also fades to nothing before its cut-off bottom edge */
  .pipe img {
    display: block; width: 100%; height: auto;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 96%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 96%);
  }
  .pipe--l { left: calc(var(--pipe-w) * -0.12); }
  .pipe--r { right: calc(var(--pipe-w) * -0.12); transform: scaleX(-1); }
  @media (min-width: 1360px) {
    .pipe { display: block; }
    /* content edge ≥ pipe + 32px: padding makes up whatever the centred max-width margin doesn't */
    .about-sec > .wrap { padding-inline: max(var(--pad-x), calc(var(--pipe-vis) + 32px - max(0px, (100vw - var(--maxw)) / 2))); }
  }

  /* first section on the sheet clears the notch cut-out */
  .sheet__first { padding-top: calc(var(--sec-top) + 38px); }

  /* BUSINESS */
  /* light grey band so the white cards read as cards. It starts below the notch cut-out (the hero shows through
     there; the sheet edge takes the same grey) and fades into the white of the next section. */
  .biz-sec { position: relative; }
  .biz-sec::before { content: ''; position: absolute; inset: calc(var(--cut-d) - 1px) 0 0 0; z-index: -1;
    /* fades into the white of the next section, so there is no hard colour seam */
    background: linear-gradient(180deg, var(--biz-bg) 0%, var(--biz-bg) 45%, var(--white) 100%);
  }
  /* section headline: two lines at most, scaled down where needed */
  .biz-head :global(.t-xl) { font-size: clamp(28px, 4.5vw, 70px); text-wrap: balance; }
  @media (max-width: 620px) { .biz-head :global(.t-xl) { font-size: 7vw; } }
  .biz { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .biz__card {
    position: relative; display: flex; flex-direction: column; padding: 8px; border-radius: 20px;
    background: #fff; box-shadow: 0 0 0 1px rgba(var(--ink-rgb), 0.05), 0 1px 2px rgba(var(--ink-rgb), 0.04);
    transition: box-shadow 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .biz__card:hover { box-shadow: 0 0 0 1px rgba(var(--ink-rgb), 0.06), 0 18px 40px -18px rgba(var(--ink-rgb), 0.25); transform: translateY(-2px); }
  .biz__media { position: relative; aspect-ratio: 7 / 5; border-radius: 14px; overflow: hidden; background: var(--card); }
  .biz__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .biz__card:hover .biz__media img { transform: scale(1.04); }
  .biz__tag {
    position: absolute; top: 12px; right: 12px; padding: 7px 12px; border-radius: 8px;
    background: #fff; color: var(--ink); font-size: 13px; font-weight: 500; line-height: 1;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .biz__body { display: grid; gap: 10px; padding: 20px 14px 18px; flex: 1; align-content: start; }
  .biz__title {
    margin: 0; font-family: var(--display); font-size: clamp(18px, 1.35vw, 24px); font-weight: 500; line-height: 1.2; letter-spacing: 0; color: var(--ink);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.4em;
  }
  .biz__text {
    margin: 0; font-size: 14px; line-height: 1.5; color: var(--fg-muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .biz__link {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    margin: 0 14px; padding: 16px 0 12px; border-top: 1px solid rgba(var(--ink-rgb), 0.08);
    font-size: 14px; font-weight: 500; color: var(--ink);
  }
  .biz__link :global(svg) { width: 18px; height: 18px; transition: transform 0.35s var(--ease); }
  .biz__card:hover .biz__link :global(svg) { transform: translateX(3px); }
  .biz__link:hover { color: var(--blue-ink); }
  /* the whole card is clickable through the footer link */
  .biz__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .biz__link:focus-visible { outline: none; }
  .biz__link:focus-visible::after { outline: 2px solid var(--blue); outline-offset: 3px; border-radius: 20px; }
  @media (max-width: 1200px) { .biz { grid-template-columns: repeat(2, minmax(0, 1fr)); } .biz__title { font-size: clamp(18px, 2.2vw, 22px); } }
