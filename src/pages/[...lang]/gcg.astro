---
import { langOf, langPaths } from '../../i18n';
import { content } from '../../i18n/content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SubNav from '../../components/SubNav.astro';
import SectionHead from '../../components/SectionHead.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import Notch from '../../components/Notch.astro';
import { articlesBy } from '../../lib/content';

const lang = langOf(Astro.params);
const { gcgHero, governance, principles, policyBasis, roadmap, antiBribery, wbs, shareholder, csr, k3pl } = content(lang);
const L = {
  id: {
    title: 'GCG & Kepatuhan', heroLines: ['Komitmen untuk', 'Transparansi'], heroAlt: 'Dua teknisi PGN Solution berhelm meninjau data di tablet di samping panel instrumen fasilitas gas',
    sub: ['GCG', 'Anti Penyuapan', 'WBS', 'Shareholder', 'CSR', 'K3PL'], basis: 'Landasan', basisTabs: 'Dasar kebijakan', regs: 'Regulasi', internal: 'Pedoman Internal',
    journey: 'Perjalanan', prevYear: 'Tahun sebelumnya', nextYear: 'Tahun berikutnya', rmYears: 'Tahun roadmap', email: 'Kirim email', visit: 'Kunjungi situs',
  },
  en: {
    title: 'GCG & Compliance', heroLines: ['Commitment to', 'Transparency'], heroAlt: 'Two PGN Solution technicians in helmets reviewing data on a tablet beside a gas facility instrument panel',
    sub: ['GCG', 'Anti-Bribery', 'WBS', 'Shareholder', 'CSR', 'HSSE'], basis: 'Foundation', basisTabs: 'Policy basis', regs: 'Regulations', internal: 'Internal Guidelines',
    journey: 'Journey', prevYear: 'Previous year', nextYear: 'Next year', rmYears: 'Roadmap years', email: 'Send email', visit: 'Visit site',
  },
}[lang];
const sub = ['#gcg', '#smap', '#wbs', '#shareholder', '#csr', '#hsse'].map((href, i) => ({ label: L.sub[i], href }));
const csrArticles = articlesBy('csr', lang);
// CSR area icons: workforce (hard hat), environment (leaf), community (people), customers (heart), medical workers (cross)
const csrIcons = [
  'M2.5 18.5h19M4.5 18.5V16a7.5 7.5 0 0 1 5-7.1V6.5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v2.4a7.5 7.5 0 0 1 5 7.1v2.5M12 5.5v4',
  'M5 19.5c0-8.5 5.5-14.5 15-14.5 0 10-6 15-14.2 15M5 19.5l8.5-8.5',
  'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM2.5 20c.6-3.6 3.3-6 6.5-6s5.9 2.4 6.5 6M16 4.3a3.5 3.5 0 0 1 0 6.4M18 14.4c2 .8 3.2 2.8 3.5 5.6',
  'M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20Z',
  'M9 3.5h6v5.5h5.5v6H15v5.5H9V15H3.5V9H9z',
];
// WBS channel icons: website, email, official letter
const channelIcons = [
  'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3Z',
  'M3 5.5h18v13H3zM3.5 6l8.5 7 8.5-7',
  'M4 21V7l8-4 8 4v14M2 21h20M9.5 21v-5h5v5M8 10h2M14 10h2',
];
const lastYear = roadmap.years.length - 1;
const pad = (n: number) => String(n).padStart(2, '0');
// policy basis groups (external regulations, internal guidelines) for the tabs
const basisGroups = [
  { label: L.regs, items: policyBasis.regulations, note: '', icon: 'M12 3 3 7.5h18L12 3ZM5 10v7M9.5 10v7M14.5 10v7M19 10v7M3 20.5h18' },
  { label: L.internal, items: policyBasis.internal, note: policyBasis.internalIntro, icon: 'M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8l-5-5ZM14 3v5h5M9 13h6M9 16.5h4' },
];
export const getStaticPaths = langPaths;
---
<Base title={L.title} description={gcgHero.text} image="/media/hero/gcg.jpg">
  <PageHero eyebrow={L.title} title={gcgHero.title} text={gcgHero.text} image="/media/hero/gcg.webp" imageSrcset="/media/hero/gcg.webp 1774w, /media/hero/gcg@2x.webp 3548w" imageAlt={L.heroAlt} crumbs={[{ label: L.title }]} lines={L.heroLines} />
  <SubNav items={sub} />

  <!-- GCG -->
  <section id="gcg" class="section gcg-sec" aria-labelledby="gcg-title">
    <div class="wrap">
      <div class="split">
        <div class="split__head"><p class="t-eyebrow">GCG</p><h2 id="gcg-title" class="t-lg">{governance.title}</h2></div>
        <div class="prose">{governance.paragraphs.map((p) => <p>{p}</p>)}</div>
      </div>

      <div class="section-gap">
        <SectionHead title={principles.title} text={principles.intro} size="lg" maxw="20ch" />
        <!-- Principles: five panels (navy → PGN blue). Closed panels show the name upright like the history
             years; the one in focus widens to show its name, English term and meaning. Phones: all open. JS: initExpand -->
        <ol class="tarif" role="list" data-expand>
          {principles.items.map((p, i) => (
            <li class:list={['tarif__item', i === 0 && 'is-active']} style={`--mix:${Math.round((i / (principles.items.length - 1)) * 88)}%`} tabindex="0" data-expand-item>
              <span class="tarif__label" aria-hidden="true">{p.name}</span>
              <div class="tarif__body">
                {p.en !== p.name && <span class="tarif__en">{p.en}</span>}
                <h3 class="tarif__name">{p.name}</h3>
                <p class="tarif__text">{p.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="split section-gap">
        <div class="split__head"><h3 class="t-lg" style="text-wrap:balance">{principles.adaptedIntro}</h3><p class="t-body" style="max-width:40ch">{principles.adaptedText}</p></div>
        <div class="acc">
          {principles.adapted.map((a, i) => (
            <details open={i === 0}>
              <summary><span class="acc__title">{a.title}</span><span class="acc__icon"><Icon name="plus" /></span></summary>
              <div class="acc__body">
                {a.paragraphs.map((p) => <p>{p}</p>)}
                {a.list && <ul class="rows rows--top" role="list">{a.list.map((x, j) => <li><span class="t-index">{pad(j + 1)}</span><span>{x}</span></li>)}</ul>}
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- Policy basis: head + segmented tabs (Regulasi / Pedoman Internal); each group's documents as
           tiles in the Produk & Jasa chip style, two columns. JS: initTabs -->
      <div class="section-gap" data-tabs>
        <div class="pb-head">
          <div class="pb-head__intro">
            <p class="t-eyebrow">{L.basis}</p>
            <h3 class="t-lg">{policyBasis.title}</h3>
            <p class="t-body">{policyBasis.intro}</p>
          </div>
          <div class="seg-tabs" role="tablist" aria-label={L.basisTabs}>
            {basisGroups.map((g, i) => (
              <button type="button" role="tab" class="seg-tab" id={`pb-tab-${i}`} aria-controls={`pb-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={i}>
                {g.label}<span class="seg-tab__count">{g.items.length}</span>
              </button>
            ))}
          </div>
        </div>
        {basisGroups.map((g, i) => (
          <div class="pb-panel" role="tabpanel" id={`pb-panel-${i}`} aria-labelledby={`pb-tab-${i}`} hidden={i > 0} data-tab-panel={i}>
            {g.note && <p class="pb-note">{g.note}</p>}
            {g.items.map((r) => (
              <div class="pb-tile">
                <span class="pb-tile__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={g.icon} /></svg></span>
                <span class="pb-tile__text">{r}</span>
              </div>
            ))}
          </div>
        ))}
      </div>

      <!-- Roadmap: one year at a time. A rail of year stops on top (the chosen one lights up and the rail
           fills to it); below, that year's number + count and its initiatives as a plain numbered list
           (two columns for busy years). Chevrons step through the years. JS: initTabs -->
      <div class="section-gap rm" data-tabs>
        <div class="rm-head">
          <div class="rm-head__title">
            <p class="t-eyebrow">{L.journey}</p>
            <h3 class="t-lg">{roadmap.title}</h3>
          </div>
          <div class="rm-head__nav">
            <button type="button" class="chev-btn chev-btn--prev" data-tab-prev aria-label={L.prevYear}><Icon name="chev" /></button>
            <button type="button" class="chev-btn chev-btn--next" data-tab-next aria-label={L.nextYear}><Icon name="chev" /></button>
          </div>
        </div>
        <div class="rm-rail" role="tablist" aria-label={L.rmYears} style={`--n:${roadmap.years.length}`}>
          <span class="rm-rail__line" aria-hidden="true"><span class="rm-rail__fill"></span></span>
          {roadmap.years.map((y, i) => (
            <button type="button" role="tab" class="rm-stop" id={`rm-tab-${y.year}`} aria-controls={`rm-panel-${y.year}`} aria-selected={i === lastYear ? 'true' : 'false'} tabindex={i === lastYear ? 0 : -1} data-tab={i}>
              <span class="rm-stop__dot" aria-hidden="true"></span>
              <span class="rm-stop__year">{y.year}</span>
            </button>
          ))}
        </div>
        {roadmap.years.map((y, i) => (
          <div class:list={['rm-panel', y.items.length > 7 && 'rm-panel--dense']} role="tabpanel" id={`rm-panel-${y.year}`} aria-labelledby={`rm-tab-${y.year}`} hidden={i !== lastYear} data-tab-panel={i}>
            <div class="rm-panel__side">
              <p class="rm-panel__year t-num">{y.year}</p>
              <p class="rm-panel__count">{y.items.length} {lang === 'en' ? 'initiatives' : 'inisiatif'}</p>
            </div>
            <ol class="rm-list" role="list">
              {y.items.map((x, j) => <li><span class="rm-list__no">{pad(j + 1)}</span><span>{x}</span></li>)}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SMAP: sticky head + intro on the left, the seven commitments on the right, closed by the
       management statement as a highlighted card. -->
  <section id="smap" class="section theme-dark smap-sec" aria-labelledby="smap-title">
    <Notch dir="down" color="#fff" depth={32} class="smap-sec__tab smap-sec__tab--top" />
    <Notch dir="up" color="#fff" depth={32} class="smap-sec__tab smap-sec__tab--bottom" />
    <div class="wrap">
      <div class="split">
        <div class="split__head">
          <p class="t-eyebrow">SMAP</p>
          <h2 id="smap-title" class="t-lg" style="text-wrap:balance">{antiBribery.title}</h2>
          <span class="chip">ISO 37001:2016</span>
          <p class="t-body" style="max-width:44ch">{antiBribery.intro}</p>
        </div>
        <div class="split__body">
          <ol class="rows rows--top" role="list">{antiBribery.items.map((x, i) => <li data-reveal="fade"><span class="t-index">{pad(i + 1)}</span><span>{x}</span></li>)}</ol>
          <blockquote class="smap__closing" data-reveal="fade"><p>{antiBribery.closing}</p></blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- WBS -->
  <section id="wbs" class="section" aria-labelledby="wbs-title">
    <div class="wrap">
      <div class="split">
        <div class="split__head"><p class="t-eyebrow">WBS</p><h2 id="wbs-title" class="t-md" style="text-wrap:balance">{wbs.title}</h2></div>
        <div class="prose">{wbs.paragraphs.map((p) => <p>{p}</p>)}</div>
      </div>

      <!-- WBS flow as connected steps, on the same two columns as the intro above: the step number + title
           sit on the left (sticky while the step is read, lit when current) on one continuous rail; each
           step's content sits on the right. JS: initSteps-like spy (initWbsSteps) -->
      <ol class="wb-steps" role="list" data-wb-steps>
        <li class="wb-step" data-wb-step>
          <div class="wb-step__head"><span class="wb-step__no" aria-hidden="true">01</span><h3 class="wb-step__title">{wbs.reportableTitle}</h3></div>
          <div class="wb-step__body">
            <ul class="wb-tiles" role="list">
              {wbs.reportable.map((x) => (
                <li class="pb-tile">
                  <span class="pb-tile__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3.5 2.5 20h19L12 3.5ZM12 10v4.5M12 17.5v.5" /></svg></span>
                  <span class="pb-tile__text">{x}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
        <li class="wb-step" data-wb-step>
          <div class="wb-step__head"><span class="wb-step__no" aria-hidden="true">02</span><h3 class="wb-step__title">{wbs.channelsTitle}</h3></div>
          <div class="wb-step__body">
            <ul class="wb-channels" role="list">
              {wbs.channels.map((c, i) => (
                <li class="wb-channel">
                  <span class="wb-channel__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={channelIcons[i % channelIcons.length]} /></svg></span>
                  <div class="wb-channel__main">
                    <p class="wb-channel__label">{c.label}</p>
                    {c.href ? <p class="wb-channel__value">{c.value}</p> : <p class="wb-channel__text">{c.value}</p>}
                  </div>
                  {c.href && (
                    <a class="wb-channel__link" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                      {c.href.startsWith('mailto') ? L.email : L.visit}<Icon name={c.href.startsWith('mailto') ? 'arrow' : 'arrow-up-right'} />
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </li>
        <li class="wb-step" data-wb-step>
          <div class="wb-step__head"><span class="wb-step__no" aria-hidden="true">03</span><h3 class="wb-step__title">{wbs.protectionTitle}</h3></div>
          <div class="wb-step__body">
            <div class="wb-protect">
              <p class="wb-protect__text">{wbs.protection}</p>
              <ul class="wb-protect__list" role="list">
                {wbs.protectionList.map((x) => (
                  <li>
                    <span class="wb-protect__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7.5 3v5.5c0 4.4-3.1 8.2-7.5 9.5-4.4-1.3-7.5-5.1-7.5-9.5V6L12 3ZM8.5 12l2.5 2.5 4.5-5" /></svg></span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
        <li class="wb-step" data-wb-step>
          <div class="wb-step__head"><span class="wb-step__no" aria-hidden="true">04</span><h3 class="wb-step__title">{wbs.legalTitle}</h3></div>
          <div class="wb-step__body">
            <ul class="wb-tiles wb-tiles--one" role="list">
              {wbs.legal.map((x) => (
                <li class="pb-tile">
                  <span class="pb-tile__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8l-5-5ZM14 3v5h5M9 13h6M9 16.5h4" /></svg></span>
                  <span class="pb-tile__text">{x}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- SHAREHOLDER -->
  <!-- a centred statement over the parent's logo in a single cell of the homepage client grid
       (crosshair corners, lines running out on every side and fading) -->
  <section id="shareholder" class="section sh-sec" aria-labelledby="sh-title">
    <div class="wrap sh">
      <p class="t-eyebrow">{shareholder.title}</p>
      <h2 id="sh-title" class="t-lg sh__text">{shareholder.text}</h2>
      <div class="sh-mark">
        <span class="sh-mark__h sh-mark__h--t" aria-hidden="true"></span>
        <span class="sh-mark__h sh-mark__h--b" aria-hidden="true"></span>
        <span class="sh-mark__v sh-mark__v--l" aria-hidden="true"></span>
        <span class="sh-mark__v sh-mark__v--r" aria-hidden="true"></span>
        <div class="sh-mark__cell">
          <span class="sh-mark__x sh-mark__x--tl" aria-hidden="true"></span>
          <span class="sh-mark__x sh-mark__x--tr" aria-hidden="true"></span>
          <span class="sh-mark__x sh-mark__x--bl" aria-hidden="true"></span>
          <span class="sh-mark__x sh-mark__x--br" aria-hidden="true"></span>
          <img src={shareholder.logo} alt="PT Perusahaan Gas Negara Tbk" width="1200" height="353" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- CSR -->
  <section id="csr" class="section" aria-labelledby="csr-title">
    <div class="wrap">
      <SectionHead eyebrow="CSR" title={csr.title} text={csr.text} id="csr-title" size="lg" maxw="20ch" />
      <!-- five areas as a bento (three, then two wider); each card has an icon for its theme and fills blue on hover -->
      <ul class="csr" role="list">
        {csr.items.map((c, i) => (
          <li class="csr__card" data-reveal="fade">
            <span class="csr__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={csrIcons[i % csrIcons.length]} /></svg></span>
            <h3 class="csr__title">{c.title}</h3>
            <p class="csr__text">{c.text}</p>
          </li>
        ))}
      </ul>
      <div class="section-gap">
        <div class="head-row"><h3 class="t-lg">{csr.latestTitle}</h3></div>
        <div class="cards" style="--n:3">{csrArticles.map((a) => <ArticleCard article={a} showCategory={false} ratio="3/2" />)}</div>
      </div>
    </div>
  </section>

  <!-- K3PL -->
  <section id="hsse" class="section hsse-sec" aria-labelledby="hsse-title">
    <div class="wrap">
      <div class="split">
        <div class="split__head"><p class="t-eyebrow">{lang === 'en' ? 'HSSE Commitment' : 'Komitmen K3PL'}</p><h2 id="hsse-title" class="t-lg">{k3pl.title}</h2></div>
        <div class="split__body">
          {k3pl.paragraphs.map((p) => <p class="t-body">{p}</p>)}
          <p class="t-sm">{k3pl.intro}</p>
          <ol class="rows rows--top" role="list">{k3pl.items.map((x, i) => <li data-reveal="fade"><span class="t-index">{pad(i + 1)}</span><span>{x}</span></li>)}</ol>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* principle panels */
  .tarif { --gap: clamp(8px, 0.8vw, 12px); --pad: clamp(22px, 2vw, 30px); container-type: inline-size; list-style: none; margin: 0; padding: 0; display: flex; gap: var(--gap); height: clamp(380px, 31vw, 460px); }
  .tarif__item {
    position: relative; flex: 1 1 0; min-width: 0; overflow: hidden; border-radius: 18px; padding: var(--pad); color: #fff; cursor: pointer; outline: none;
    background: color-mix(in srgb, var(--blue) var(--mix, 0%), var(--ink)); transition: flex-grow 0.7s var(--ease);
  }
  .tarif__item::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(120% 80% at 100% 0%, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 60%); }
  .tarif__item.is-active { flex-grow: 3.4; cursor: default; }
  .tarif__item:focus-visible { box-shadow: inset 0 0 0 2px #fff; }
  /* closed: the name reads upright along the panel, like the history years */
  .tarif__label {
    position: absolute; left: var(--pad); top: var(--pad); writing-mode: vertical-rl; transform: rotate(180deg); transform-origin: center;
    font-family: var(--display); font-weight: 500; font-size: clamp(20px, 1.7vw, 26px); line-height: 1; white-space: nowrap; transition: opacity 0.3s;
  }
  .tarif__item.is-active .tarif__label { opacity: 0; }
  /* open: laid out at the open width (3.4 of 7.4 shares after gaps and padding), so it doesn't reflow while the panel widens */
  .tarif__body {
    position: absolute; left: var(--pad); bottom: var(--pad); width: calc((100cqi - 4 * var(--gap) - 10 * var(--pad)) * 0.459); display: grid; gap: 12px;
    opacity: 0; transform: translateY(10px); transition: opacity 0.3s, transform 0.4s var(--ease); pointer-events: none;
  }
  .tarif__item.is-active .tarif__body { opacity: 1; transform: none; transition: opacity 0.5s 0.25s, transform 0.6s 0.25s var(--ease); }
  .tarif__en { font-size: 14px; color: rgba(255, 255, 255, 0.7); }
  .tarif__name { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(24px, 2.2vw, 32px); line-height: 1.15; }
  .tarif__text { margin: 0; font-size: clamp(15px, 1.1vw, 17px); line-height: 1.5; color: rgba(255, 255, 255, 0.88); max-width: 46ch; }
  /* narrow screens: all open, stacked */
  @media (max-width: 900px) {
    .tarif { flex-direction: column; height: auto; }
    .tarif__item, .tarif__item.is-active { flex: none; cursor: default; }
    .tarif__label { display: none; }
    .tarif__body, .tarif__item.is-active .tarif__body { position: static; width: auto; opacity: 1; transform: none; gap: 8px; }
    .tarif__name { font-size: 22px; }
  }
  /* policy basis */
  .pb-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px 48px; margin-bottom: clamp(28px, 3vw, 44px); }
  .pb-head__intro { display: grid; gap: 14px; justify-items: start; min-width: 0; }
  .pb-head__intro :global(.t-lg), .pb-head__intro :global(.t-body) { margin: 0; }
  .pb-head__intro :global(.t-body) { max-width: 60ch; }
  .pb-panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(10px, 1vw, 14px); }
  .pb-panel[hidden] { display: none; }
  .pb-note { grid-column: 1 / -1; margin: 0 0 8px; max-width: 80ch; font-size: 15px; line-height: 1.55; color: var(--fg-muted); }
  .pb-tile {
    display: flex; align-items: center; gap: 14px; padding: 12px 20px 12px 12px; border-radius: 16px; background: #f2f3f5; color: var(--ink);
    transition: background-color 0.35s, color 0.35s, transform 0.45s var(--ease);
  }
