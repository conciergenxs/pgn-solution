  .sh-mark { --cell-w: min(400px, 78vw); --cell-h: clamp(170px, 15vw, 220px); --run: clamp(48px, 6vw, 96px); --ln: #e5e5e5;
    position: relative; width: 100%; height: calc(var(--cell-h) + 2 * var(--run)); margin-top: clamp(8px, 1vw, 16px); }
  /* lines that run out from the cell on every side and fade */
