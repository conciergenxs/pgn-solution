---
import { langOf, langPaths } from '../../../i18n';
import { content } from '../../../i18n/content';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHead from '../../../components/SectionHead.astro';
import Icon from '../../../components/Icon.astro';
import { reports } from '../../../lib/content';

const lang = langOf(Astro.params);
const { investorHero, highlightsIntro, highlights, featuredReport } = content(lang);
const L = {
  id: {
    title: 'Relasi Investor', heroLines: ['Meningkatkan kualitas', 'untuk masa depan', 'yang lebih baik'], heroAlt: 'Tim PGN Solution berseragam meninjau dokumen di ruang kendali dengan layar peta jaringan pipa',
    year: 'Tahun', download: 'Unduh Annual Report', cover: 'Sampul Annual Report', readMore: 'Baca selengkapnya', reports: 'laporan', prev: 'Laporan sebelumnya', next: 'Laporan berikutnya',
  },
  en: {
    title: 'Investor Relations', heroLines: ['Enhancing quality', 'for a greater', 'future'], heroAlt: 'PGN Solution team in uniform reviewing documents in a control room with a pipeline network map screen',
    year: 'Year', download: 'Download Annual Report', cover: 'Annual Report cover', readMore: 'Read more', reports: 'reports', prev: 'Previous reports', next: 'Next reports',
  },
}[lang];

const latest = reports[0];
// faint trend lines for the highlight cells (Catmull-Rom → Bézier) in an SW×SH box
const SW = 240, SH = 56;
const sparks = highlights.map((h) => {
  const max = Math.max(...h.data), min = Math.min(...h.data);
  const pts = h.data.map((v, i) => [(i / Math.max(1, h.data.length - 1)) * SW, SH * 0.9 - ((v - min) / (max - min || 1)) * SH * 0.8]);
  let line = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const [p0, p1, p2, p3] = [pts[i - 1] ?? pts[i], pts[i], pts[i + 1], pts[i + 2] ?? pts[i + 1]];
    line += ` C${(p1[0] + (p2[0] - p0[0]) / 6).toFixed(1)},${(p1[1] + (p2[1] - p0[1]) / 6).toFixed(1)} ${(p2[0] - (p3[0] - p1[0]) / 6).toFixed(1)},${(p2[1] - (p3[1] - p1[1]) / 6).toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
  }
  return { line, area: `${line} L${SW},${SH} L0,${SH} Z` };
});
const previous = reports.slice(1);
export const getStaticPaths = langPaths;
---
<Base title={L.title} description={investorHero.text} image="/media/hero/investor.jpg">
  <PageHero eyebrow={L.title} title={investorHero.title} text={investorHero.text} image="/media/hero/investor.webp" imageSrcset="/media/hero/investor.webp 1774w, /media/hero/investor@2x.webp 3548w" imageAlt={L.heroAlt} crumbs={[{ label: L.title }]} lines={L.heroLines} />

  <!-- Highlights in the homepage client-grid vocabulary: four cells on white between hairlines, crosshairs at the
       crossings, lines running out and fading; each cell has its figure and a faint trend line as an accent -->
  <section id="highlight" class="section hl-sec" aria-labelledby="hl-title">
    <div class="wrap">
      <SectionHead eyebrow={highlightsIntro.eyebrow} title={highlightsIntro.title} text={highlightsIntro.text} id="hl-title" size="lg" maxw="20ch" />
      <div class="hlg" style={`--n:${highlights.length}`}>
        {Array.from({ length: highlights.length + 1 }, (_, k) => (
          <>
            <span class="hlg__v" style={`--k:${k}`} data-k={k} aria-hidden="true"></span>
            <span class="hlg__x hlg__x--t" style={`--k:${k}`} data-k={k} aria-hidden="true"></span>
            <span class="hlg__x hlg__x--b" style={`--k:${k}`} data-k={k} aria-hidden="true"></span>
          </>
        ))}
        <ul class="hlg__cells" role="list">
          {highlights.map((h, i) => (
            <li class="hlg__cell" data-reveal="fade" style={`transition-delay:${i * 70}ms`}>
              <span class="hlg__prefix">{h.prefix}</span>
              <span class="hlg__value t-num"><span data-count>{h.value}</span></span>
              <span class="hlg__label">{h.label}</span>
              <svg class="hlg__spark" viewBox={`0 0 ${SW} ${SH}`} preserveAspectRatio="none" aria-hidden="true">
                <path d={sparks[i].area} class="hlg__area" />
                <path d={sparks[i].line} class="hlg__line" />
              </svg>
              <span class="hlg__years" aria-hidden="true">{h.labels[0]}–{h.labels[h.labels.length - 1]}</span>
              <table class="visually-hidden">
                <caption>{h.series}, {h.labels[0]}–{h.labels[h.labels.length - 1]}</caption>
                <tr><th scope="col">{L.year}</th><th scope="col">{h.unit}</th></tr>
                {h.labels.map((l, k) => <tr><td>{l}</td><td>{h.data[k].toLocaleString('id-ID')}</td></tr>)}
              </table>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Annual report: the latest one featured (text held to four lines with "Baca selengkapnya"), then every
       earlier report right here as a scrolling row of covers (no separate page) -->
  <section id="annual-report" class="section ar-sec" aria-labelledby="ar-title">
    <div class="wrap">
      <div class="ar">
        <a class="ar__cover" href={latest.pdf} target="_blank" rel="noopener" aria-label={`${L.download} ${latest.year} (PDF)`}>
          <img src={latest.cover} alt={`${L.cover} ${latest.year}`} loading="lazy" />
        </a>
        <div class="ar__body">
          <p class="t-eyebrow">Annual Report {featuredReport.year}</p>
          <h2 id="ar-title" class="t-lg ar__title">{featuredReport.title}</h2>
          <p class="t-body ar__text" id="ar-text" data-more-text>{featuredReport.text}</p>
          <button type="button" class="ar__more" aria-controls="ar-text" aria-expanded="false" data-more>{L.readMore}</button>
          <a class="btn btn--primary btn--lg" href={latest.pdf} target="_blank" rel="noopener">{L.download} {latest.year}</a>
        </div>
      </div>

      <div class="ar-prev" data-scroller>
        <div class="ar-prev__head">
          <div>
            <h3 class="t-md ar-prev__title">Previous Annual Report</h3>
            <p class="ar-prev__meta">{previous.length} {L.reports}, {previous[previous.length - 1].year}–{previous[0].year}</p>
          </div>
          <div class="ar-prev__nav">
            <button type="button" class="chev-btn chev-btn--prev" data-scroller-prev aria-label={L.prev}><Icon name="chev" /></button>
            <button type="button" class="chev-btn chev-btn--next" data-scroller-next aria-label={L.next}><Icon name="chev" /></button>
          </div>
        </div>
        <ul class="ar-prev__track" role="list" data-scroller-track>
          {previous.map((r) => (
            <li class="ar-book">
              <a class="ar-book__link" href={r.pdf} target="_blank" rel="noopener">
                <span class="ar-book__cover"><img src={r.cover} alt="" loading="lazy" decoding="async" /></span>
                <span class="ar-book__row">
                  <span class="ar-book__year">{r.year}</span>
                  <span class="ar-book__dl"><Icon name="download" />PDF</span>
                </span>
                <span class="visually-hidden">{L.download} {r.year} (PDF)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HIGHLIGHTS — the homepage client grid: cells between hairlines, crosshairs, lines fading out */
  .hl-sec { overflow-x: clip; }
  .hl-sec :global(.sec-head) { margin-bottom: clamp(56px, 6vw, 96px); }
  .hlg { --ln: #e5e5e5; --run: clamp(40px, 5vw, 80px); position: relative; margin-block: var(--run); }
  /* top and bottom lines run past the grid and fade */
  .hlg::before, .hlg::after { content: ''; position: absolute; left: -12vw; right: -12vw; height: 1px; background: linear-gradient(90deg, rgba(229, 229, 229, 0), var(--ln) 12vw, var(--ln) calc(100% - 12vw), rgba(229, 229, 229, 0)); pointer-events: none; }
  .hlg::before { top: 0; }
  .hlg::after { bottom: 0; }
  /* column lines run above and below and fade */
  .hlg__v { position: absolute; left: calc(var(--k) * 100% / var(--n)); top: calc(-1 * var(--run)); bottom: calc(-1 * var(--run)); width: 1px; background: linear-gradient(180deg, rgba(229, 229, 229, 0), var(--ln) var(--run), var(--ln) calc(100% - var(--run)), rgba(229, 229, 229, 0)); pointer-events: none; }
  .hlg__x { position: absolute; left: calc(var(--k) * 100% / var(--n)); z-index: 2; width: 0; height: 0; pointer-events: none; }
  .hlg__x--t { top: 0; } .hlg__x--b { top: 100%; }
  .hlg__x::before, .hlg__x::after { content: ''; position: absolute; background: #979797; }
  .hlg__x::before { left: -5px; top: 0; width: 11px; height: 1px; }
  .hlg__x::after { left: 0; top: -5px; width: 1px; height: 11px; }
  .hlg__cells { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
  .hlg__cell { position: relative; display: grid; grid-template-rows: auto auto 1fr auto auto; gap: 8px; padding: clamp(24px, 2.4vw, 36px) clamp(20px, 2.2vw, 32px) clamp(18px, 1.8vw, 26px); transition: background-color 0.35s; }
  .hlg__prefix { font-size: 13px; color: var(--fg-muted); }
  .hlg__value { font-family: var(--display); font-weight: 600; font-size: clamp(28px, 2.6vw, 42px); line-height: 1; letter-spacing: -0.01em; color: var(--ink); transition: color 0.35s; }
  .hlg__label { font-size: 14px; line-height: 1.4; color: var(--fg-muted); max-width: 24ch; }
  .hlg__spark { width: 100%; height: 56px; margin-top: 18px; overflow: visible; }
  .hlg__line { fill: none; stroke: rgba(26, 144, 202, 0.45); stroke-width: 1.75; vector-effect: non-scaling-stroke; transition: stroke 0.35s; }
  .hlg__area { fill: rgba(26, 144, 202, 0.06); transition: fill 0.35s; }
  .hlg__years { font-size: 12px; color: var(--fg-muted); font-variant-numeric: tabular-nums; }
  .hlg__cell:hover { background: #f7fafc; }
  .hlg__cell:hover .hlg__value { color: var(--blue-ink); }
  .hlg__cell:hover .hlg__line { stroke: var(--blue); }
  .hlg__cell:hover .hlg__area { fill: rgba(26, 144, 202, 0.12); }
  @media (max-width: 1000px) {
    .hlg { --n: 2 !important; }
    .hlg__cells { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hlg__cell:nth-child(n + 3) { box-shadow: inset 0 1px 0 var(--ln); }
    .hlg [data-k='3'], .hlg [data-k='4'] { display: none; }
  }
  @media (max-width: 600px) {
    .hlg__cell { padding: 20px 14px 16px; }
    .hlg__value { font-size: 22px; letter-spacing: -0.02em; }
    .hlg__label { font-size: 13px; }
  }
  /* ANNUAL REPORT */
  .ar-sec { overflow-x: clip; }
  .ar { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 96px); align-items: center; }
  .ar__cover { display: block; aspect-ratio: 1253 / 1800; border-radius: 18px; overflow: hidden; box-shadow: 0 30px 60px -36px rgba(3, 34, 51, 0.55); }
  .ar__cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .ar__cover:hover img { transform: scale(1.03); }
  .ar__body { display: grid; gap: 20px; justify-items: start; }
  .ar__body :global(.t-eyebrow), .ar__title { margin: 0; }
  .ar__title { max-width: 18ch; text-wrap: balance; }
  /* the long statement shows four lines until opened */
  .ar__text { margin: 0; max-width: 62ch; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .ar__text.is-open { display: block; }
  .ar__more { margin-top: -8px; padding: 0; background: none; font-size: 15px; font-weight: 500; color: var(--blue-ink); border-bottom: 1px solid currentColor; cursor: pointer; }
  .ar__more:hover { color: var(--blue); }
  .ar__body :global(.btn) { margin-top: 8px; }
  /* every earlier report: a scrolling row of covers that runs to the page edge */
  .ar-prev { margin-top: clamp(72px, 8vw, 128px); }
  .ar-prev__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: clamp(24px, 2.6vw, 36px); }
  .ar-prev__title { margin: 0; }
  .ar-prev__meta { margin: 8px 0 0; font-size: 15px; color: var(--fg-muted); }
  .ar-prev__nav { display: flex; gap: 10px; }
  .ar-prev__track {
    list-style: none; margin: 0 calc(-1 * var(--pad-x)); padding: 8px var(--pad-x) 24px; display: flex; gap: clamp(14px, 1.6vw, 24px);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--pad-x); scrollbar-width: none;
  }
  .ar-prev__track::-webkit-scrollbar { display: none; }
  .ar-book { flex: none; width: clamp(170px, 15vw, 220px); scroll-snap-align: start; }
  .ar-book__link { display: grid; gap: 14px; text-decoration: none; color: var(--ink); }
  .ar-book__cover { display: block; aspect-ratio: 3 / 4; border-radius: 12px; overflow: hidden; background: #f2f3f5; box-shadow: 0 1px 2px rgba(3, 34, 51, 0.08); transition: transform 0.5s var(--ease), box-shadow 0.5s; }
  .ar-book__cover img { width: 100%; height: 100%; object-fit: cover; }
  .ar-book__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .ar-book__year { font-family: var(--display); font-weight: 600; font-size: 20px; line-height: 1; }
  .ar-book__dl { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 500; color: var(--blue-ink); }
  .ar-book__dl :global(svg) { width: 16px; height: 16px; }
  .ar-book__link:hover .ar-book__cover { transform: translateY(-6px); box-shadow: 0 24px 40px -24px rgba(3, 34, 51, 0.5); }
  .ar-book__link:hover .ar-book__dl { color: var(--blue); }
  .ar-book__link:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; border-radius: 12px; }
  @media (max-width: 900px) { .ar { grid-template-columns: 1fr; } .ar__cover { max-width: 360px; } }
</style>
