---
import { langOf, langPaths } from '../../../i18n';
import { content } from '../../../i18n/content';
/**
 * TUK PGAS Training Center — its own detail page (was folded into /business). The /business TUK
 * section keeps the shared business-line layout and links here ("Lihat Detail").
 * Copy is verbatim from src/data/business.ts (`tuk` + the TUK line).
 */
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SubNav from '../../../components/SubNav.astro';
import SectionHead from '../../../components/SectionHead.astro';
import Icon from '../../../components/Icon.astro';
import ContactForm from '../../../components/ContactForm.astro';
import LogoCarousel from '../../../components/LogoCarousel.astro';
import { tukPartners } from '../../../lib/content';

const lang = langOf(Astro.params);
const { tuk, lines } = content(lang);
const L = {
  id: {
    sub: ['Tentang', 'Keunggulan', 'Sertifikasi', 'Mitra', 'Registrasi'], eyebrow: 'Bisnis',
    heroAlt: 'Instruktur TUK PGAS Training Center memandu peserta berseragam oranye saat praktik pada mesin penyambung pipa',
    miles: [['Memperoleh lisensi dari LSP ENERGI', '24 Oktober 2016'], ['Bersama LSP PGN', 'Sejak 2017'], ['Ditetapkan sebagai Pusat Uji Kompetensi independen', 'Oleh LSP PGN']],
    certGroups: 'Kelompok sertifikasi', partners: 'Mitra TUK PGAS Training Center', contactForm: 'Formulir Kontak', subject: 'Pertanyaan TUK PGAS Training Center',
  },
  en: {
    sub: ['About', 'Why Us', 'Certification', 'Partners', 'Registration'], eyebrow: 'Business',
    heroAlt: 'A TUK PGAS Training Center instructor guiding trainees in orange uniforms during practice on a pipe fusion machine',
    miles: [['Obtained a license from LSP ENERGI', '24 October 2016'], ['With PGN’s LSP', 'Since 2017'], ['Established as an independent Competency Test Center', 'By LSP PGN']],
    certGroups: 'Certification groups', partners: 'TUK PGAS Training Center partners', contactForm: 'Contact Form', subject: 'TUK PGAS Training Center enquiry',
  },
}[lang];

const line = lines.find((l) => l.id === 'tuk')!;
const sub = ['#tentang', '#keunggulan', '#sertifikasi', '#mitra', '#registrasi'].map((href, i) => ({ label: L.sub[i], href }));
const pad = (n: number) => String(n).padStart(2, '0');
// registration paragraph with the address as a mailto link (the stray space before the full stop is dropped)
const [regBefore, regAfterRaw = ''] = tuk.registrationText.split(tuk.email);
const regAfter = regAfterRaw.replace(/^\s+\./, '.');
const mix = (i: number, n: number) => (n > 1 ? Math.round((i / (n - 1)) * 88) : 0);
// The about paragraph is one long sentence chain: its first sentence is the intro, and the three
// dated facts in the rest are shown as milestones (wording taken from that paragraph).
const aboutIntro = tuk.about.split('. ')[0] + '.';
const milestones = ['2016', '2017', '2020'].map((year, i) => ({ year, title: L.miles[i][0], note: L.miles[i][1] }));
// one line icon per focus area: training & certification, partnership, offline & online
const areaIcons = [
  'M12 14.5a5 5 0 1 0 0-10 5 5 0 0 0 0 10ZM8.6 13.2 7 21l5-2.6 5 2.6-1.6-7.8',
  'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM2.5 20c.6-3.6 3.3-6 6.5-6s5.9 2.4 6.5 6M16 4.3a3.5 3.5 0 0 1 0 6.4M18 14.4c2 .8 3.2 2.8 3.5 5.6',
  'M3 4.5h18v11.5H3zM8.5 20h7M12 16v4',
];
export const getStaticPaths = langPaths;
---
<Base title="TUK PGAS Training Center" description={line.text} image="/media/header/pgas-solution-tuk.jpg">
  <PageHero
    eyebrow={L.eyebrow}
    title={line.title}
    text={line.text}
    image="/media/header/pgas-solution-tuk.jpg"
    imageAlt={L.heroAlt}
    lines={['TUK PGAS', 'Training Center']}
  />
  <SubNav items={sub} />

  <!-- ABOUT: one heading + one intro sentence; the dated facts as a three-point timeline; then the
       three focus areas as icon cards -->
  <section id="tentang" class="section tk-about" aria-labelledby="tentang-title">
    <div class="wrap">
      <div class="tk-about__grid">
        <div class="tk-about__head">
          <p class="t-eyebrow">{tuk.aboutTitle}</p>
          <h2 id="tentang-title" class="t-lg tk-about__title">{tuk.heroTitle}</h2>
        </div>
        <p class="t-body tk-about__intro" data-reveal="fade">{aboutIntro}</p>
      </div>

      <ol class="tk-mile" role="list">
        {milestones.map((m, i) => (
          <li class="tk-mile__item" style={`--i:${i}`} data-reveal="fade">
            <span class="tk-mile__dot" aria-hidden="true"></span>
            <p class="tk-mile__year t-num">{m.year}</p>
            <p class="tk-mile__title">{m.title}</p>
            <p class="tk-mile__note">{m.note}</p>
          </li>
        ))}
      </ol>

      <ul class="tk-areas" role="list">
        {line.areas.map((a, i) => (
          <li class="tk-area" data-reveal="fade">
            <span class="tk-area__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={areaIcons[i % areaIcons.length]} /></svg></span>
            <h3 class="tk-area__title">{a.title}</h3>
            <p class="tk-area__text">{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- WHY: four reasons as cards, navy → PGN blue like the business portfolio cards -->
  <section id="keunggulan" class="section" aria-labelledby="keunggulan-title">
    <div class="wrap">
      <SectionHead title={tuk.whyTitle} id="keunggulan-title" size="lg" maxw="24ch" />
      <ol class="tk-why" role="list">
        {tuk.why.map((w, i) => (
          <li class="tk-why__card" style={`--mix:${mix(i, tuk.why.length)}%`} data-reveal="fade">
            <span class="tk-why__no" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="tk-why__title">{w.title}</h3>
            <p class="tk-why__text">{w.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CERTIFICATION: head + segmented tabs (one per group); each group's certifications as tiles in
       the Produk & Jasa chip style (they rise in as a wave when a tab opens). JS: initTabs -->
  <section id="sertifikasi" class="section tk-cert" aria-labelledby="sertifikasi-title" data-tabs>
    <div class="wrap">
      <div class="tk-cert__head">
        <div class="tk-cert__intro">
          <h2 id="sertifikasi-title" class="t-lg">{tuk.certTitle}</h2>
          <p class="t-body">{tuk.certText}</p>
        </div>
        <div class="seg-tabs" role="tablist" aria-label={L.certGroups}>
          {tuk.certGroups.map((g, i) => (
            <button type="button" role="tab" class="seg-tab" id={`cert-tab-${i}`} aria-controls={`cert-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={i}>
              {g.title}<span class="seg-tab__count">{g.items.length}</span>
            </button>
          ))}
        </div>
      </div>
      {tuk.certGroups.map((g, i) => (
        <ul class="tk-certs" role="tabpanel" id={`cert-panel-${i}`} aria-labelledby={`cert-tab-${i}`} hidden={i > 0} data-tab-panel={i}>
          {g.items.map((it) => (
            <li class="tk-certs__item">
              <span class="tk-certs__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7.5 3v5.5c0 4.4-3.1 8.2-7.5 9.5-4.4-1.3-7.5-5.1-7.5-9.5V6L12 3ZM8.5 12l2.5 2.5 4.5-5" /></svg></span>
              <span class="tk-certs__name">{it}</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- PARTNERS: the homepage client grid -->
  <section id="mitra" class="section tk-partners" aria-labelledby="mitra-title">
    <div class="wrap">
      <SectionHead title={tuk.partnersTitle} text={tuk.partnersText} id="mitra-title" maxw="20ch" />
      <div class="tk-partners__logos"><LogoCarousel logos={tukPartners} label={L.partners} /></div>
    </div>
  </section>

  <!-- REGISTRATION: one paragraph (email as a link) + a compact download row; the contact form beside it -->
  <section id="registrasi" class="section" aria-labelledby="registrasi-title">
    <div class="wrap tk-reg">
      <div class="tk-reg__info">
        <h2 id="registrasi-title" class="t-lg">{tuk.registrationTitle}</h2>
        <p class="t-body">{regBefore}<a class="tk-reg__mail" href={`mailto:${tuk.email}`}>{tuk.email}</a>{regAfter}</p>
        <a class="tk-reg__doc" href={tuk.registrationForm.href} target="_blank" rel="noopener">
          <span class="tk-reg__doc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8l-5-5ZM14 3v5h5M9 13h6M9 16.5h4" /></svg></span>
          <span class="tk-reg__doc-text"><span class="tk-reg__doc-name">{tuk.registrationForm.label}</span><span class="tk-reg__doc-meta">PDF</span></span>
          <span class="tk-reg__doc-btn"><Icon name="download" /><span>Download</span></span>
        </a>
      </div>
      <div class="tk-reg__form theme-dark">
        <h3 class="t-md">{L.contactForm}</h3>
        <ContactForm mailto={tuk.email} subject={L.subject} id="tuk-form" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ABOUT */
  .tk-about__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px clamp(32px, 5vw, 96px); align-items: end; }
  .tk-about__head { display: grid; gap: clamp(14px, 1.4vw, 20px); justify-items: start; }
  .tk-about__title { margin: 0; text-wrap: balance; }
  .tk-about__intro { margin: 0; max-width: 46ch; font-size: clamp(16px, 1.25vw, 19px); }
  /* timeline: a hairline with a dot per milestone */
  .tk-mile { position: relative; list-style: none; margin: clamp(56px, 6vw, 96px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 2.4vw, 40px); }
  .tk-mile::before { content: ''; position: absolute; left: 0; right: 0; top: 6px; height: 1px; background: var(--line); }
  .tk-mile__item { position: relative; display: grid; gap: 8px; align-content: start; padding-top: 36px; }
  .tk-mile__dot { position: absolute; left: 0; top: 0; width: 13px; height: 13px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 5px rgba(26, 144, 202, 0.15); }
  .tk-mile__year { margin: 0; font-family: var(--display); font-weight: 600; font-size: clamp(40px, 3.6vw, 56px); line-height: 1; color: var(--ink); }
  .tk-mile__title { margin: 6px 0 0; font-family: var(--display); font-weight: 500; font-size: clamp(17px, 1.35vw, 20px); line-height: 1.3; color: var(--ink); max-width: 24ch; }
  .tk-mile__note { margin: 0; font-size: 14px; color: var(--fg-muted); }
  /* focus areas: white cards with an icon chip */
  .tk-areas { list-style: none; margin: clamp(56px, 6vw, 96px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 20px); }
  .tk-area {
    display: grid; align-content: start; gap: 12px; padding: clamp(24px, 2.4vw, 32px); border-radius: 18px;
    background: #fff; box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow 0.35s, transform 0.45s var(--ease);
  }
  .tk-area__icon { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 12px; border-radius: 12px; background: rgba(26, 144, 202, 0.1); color: var(--blue); transition: background-color 0.35s, color 0.35s; }
  .tk-area__icon svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .tk-area__title { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(18px, 1.5vw, 22px); line-height: 1.25; color: var(--ink); }
  .tk-area__text { margin: 0; font-size: 15px; line-height: 1.5; color: var(--fg-muted); }
  .tk-area:hover { box-shadow: inset 0 0 0 1px var(--blue); transform: translateY(-3px); }
  .tk-area:hover .tk-area__icon { background: var(--blue); color: #fff; }

  /* WHY */
  .tk-why { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 20px); }
  .tk-why__card {
    position: relative; display: flex; flex-direction: column; gap: 16px; min-height: clamp(240px, 20vw, 300px); padding: clamp(24px, 2.4vw, 36px); border-radius: 18px; overflow: hidden;
    color: #fff; background: color-mix(in srgb, var(--blue) var(--mix, 0%), var(--ink)); transition: transform 0.5s var(--ease), box-shadow 0.5s;
  }
  .tk-why__card::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(120% 80% at 100% 0%, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 60%); }
  .tk-why__card:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -30px rgba(3, 34, 51, 0.55); }
  .tk-why__no { font-size: 14px; color: rgba(255, 255, 255, 0.55); font-variant-numeric: tabular-nums; }
  .tk-why__title { margin: auto 0 0; font-family: var(--display); font-weight: 500; font-size: clamp(20px, 1.7vw, 26px); line-height: 1.25; max-width: 26ch; }
  .tk-why__text { margin: 0; font-size: 15px; line-height: 1.5; color: rgba(255, 255, 255, 0.85); max-width: 56ch; }

  /* CERTIFICATION */
  .tk-cert__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px 48px; margin-bottom: clamp(28px, 3vw, 44px); }
  .tk-cert__intro { display: grid; gap: 14px; min-width: 0; }
  .tk-cert__intro :global(.t-lg), .tk-cert__intro :global(.t-body) { margin: 0; }
  /* tiles: the Produk & Jasa chip, in an even grid */
  .tk-certs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1vw, 14px); }
  .tk-certs[hidden] { display: none; }
  .tk-certs__item {
    display: flex; align-items: center; gap: 14px; padding: 10px 18px 10px 10px; border-radius: 16px; background: #f2f3f5; color: var(--ink);
    transition: background-color 0.35s, color 0.35s, transform 0.45s var(--ease);
  }
  .tk-certs__icon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 11px; background: #fff; color: var(--blue); transition: background-color 0.35s, color 0.35s; }
  .tk-certs__icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .tk-certs__name { font-family: var(--display); font-weight: 500; font-size: clamp(15px, 1.15vw, 17px); line-height: 1.3; }
  @media (hover: hover) and (pointer: fine) {
    .tk-certs__item:hover { background: var(--blue); color: #fff; transform: translateY(-2px); }
    .tk-certs__item:hover .tk-certs__icon { background: rgba(255, 255, 255, 0.18); color: #fff; }
  }

  /* PARTNERS: room above/below for the client grid's fading lines */
  .tk-partners { overflow-x: clip; }
  .tk-partners__logos { --lc-max: 1000px; overflow-x: clip; margin-top: calc(min(11.979vw, 200px) + 16px); margin-bottom: min(11.979vw, 160px); padding-inline: 4px; }

  /* REGISTRATION */
  .tk-reg { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 96px); align-items: start; }
  .tk-reg__info { display: grid; gap: 24px; align-content: start; }
  .tk-reg__info :global(.t-lg), .tk-reg__info :global(.t-body) { margin: 0; }
  .tk-reg__mail { white-space: nowrap; color: var(--blue-ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .tk-reg__mail:hover { color: var(--blue); }
  /* one compact row: file icon, name + type, download */
  .tk-reg__doc {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16px; margin-top: 8px; padding: 12px 12px 12px 14px;
    border-radius: 16px; background: #fff; box-shadow: inset 0 0 0 1px var(--line); color: var(--ink); text-decoration: none; transition: box-shadow 0.3s;
  }
  .tk-reg__doc:hover { box-shadow: inset 0 0 0 1px var(--blue); }
  .tk-reg__doc:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  .tk-reg__doc-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: rgba(26, 144, 202, 0.1); color: var(--blue); }
  .tk-reg__doc-icon svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .tk-reg__doc-text { display: grid; gap: 2px; min-width: 0; }
  .tk-reg__doc-name { font-family: var(--display); font-weight: 500; font-size: 17px; line-height: 1.3; }
  .tk-reg__doc-meta { font-size: 13px; color: var(--fg-muted); }
  .tk-reg__doc-btn { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: var(--radius-btn); background: var(--blue); color: #fff; font-size: 14px; font-weight: 500; transition: background-color 0.25s; }
  .tk-reg__doc-btn :global(svg) { width: 16px; height: 16px; }
  .tk-reg__doc:hover .tk-reg__doc-btn { background: #2aa3df; }
  .tk-reg__form { border-radius: var(--radius-card); padding: clamp(28px, 3.5vw, 56px); display: grid; gap: 32px; }

  @media (max-width: 1000px) {
    .tk-about__grid, .tk-reg { grid-template-columns: minmax(0, 1fr); }
    .tk-cert__head { flex-direction: column; align-items: flex-start; }
    .tk-certs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tk-about__grid { align-items: start; }
    .tk-areas { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 700px) {
    /* timeline turns vertical */
    .tk-mile { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-left: 32px; }
    .tk-mile::before { left: 6px; right: auto; top: 6px; bottom: 6px; width: 1px; height: auto; }
    .tk-mile__item { padding-top: 0; }
    .tk-mile__dot { left: -32px; top: 6px; }
    .tk-why { grid-template-columns: minmax(0, 1fr); }
    .tk-why__card { min-height: 0; }
    .tk-why__title { margin-top: 8px; }
    .tk-certs { grid-template-columns: minmax(0, 1fr); }
  }
</style>
